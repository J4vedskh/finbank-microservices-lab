          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(up, group)",
        "hide": 0,
        "includeAll": false,
        "label": "Service group",
        "multi": false,
        "name": "service_group",
        "options": [],
