          "query": "label_values(up, group)",
          "refId": "PrometheusVariableQueryEditor-ServiceGroup"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
